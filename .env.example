# Copy to .env.local and fill in. Never commit real keys.

# Gemini API key for the AI Core guide. Server-only: never prefix with NEXT_PUBLIC_.
# Without it, the AI Core answers from the portfolio content (static fallback).
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-flash-lite-latest).
# GEMINI_MODEL=

# Optional: the site's public URL, for canonical links, link previews,
# robots.txt and the sitemap, e.g. https://your-domain.com. Read at build time.
# On Vercel the production deployment URL is used until this is set.
# SITE_URL=
